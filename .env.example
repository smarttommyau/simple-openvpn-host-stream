# =============================================================================
# Simple OpenVPN Stream Proxy - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running docker-compose up
# =============================================================================

# -----------------------------------------------------------------------------
# OpenVPN Configuration
# -----------------------------------------------------------------------------
# Path to OpenVPN configuration file (relative to project root)
# The dperson/openvpn-client container will use this config to connect to the target site
OPENVPN_CONFIG_PATH=./openvpn-config/openvpn.ovpn


# -----------------------------------------------------------------------------
# Stream Configuration
# -----------------------------------------------------------------------------
# Target streaming site URL (e.g., YouTube, Twitch, generic HTTP stream)
# This is the link that will be connected to via OpenVPN tunnel
# Example: https://www.youtube.com/watch?v=example
# Example: https://twitch.tv/username
# Example: http://stream.example.com/live.m3u8
STREAM_URL=https://www.youtube.com/watch?v=example

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Web server port (default: 8080)
# This port will be forwarded from host to container
PORT=8080

# Stream timeout in seconds (default: 30)
# After this duration without new data, stream will restart automatically
TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# System Configuration
# -----------------------------------------------------------------------------
# Timezone for containers (default: Asia/Hong_Kong)
TZ=Asia/Hong_Kong
