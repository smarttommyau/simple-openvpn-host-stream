FROM node:18-alpine

# Install ffmpeg, streamlink, and TypeScript tools
RUN apk add --no-cache \
    ffmpeg \
    streamlink \
    python3 \
    py3-pip \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package.json and install dependencies (including @types/node)
COPY package.json ./
RUN npm install

# Copy TypeScript configuration
COPY tsconfig.json ./

# Copy source files
COPY src/ ./src/

# Build TypeScript to JavaScript
RUN npm run build

# Copy public directory for static files
COPY public/ ./public/

# Expose port
EXPOSE 8080

# Set environment variables from .env file if present (Docker best practice)
ENV TZ=Asia/Hong_Kong

# Start the compiled application
CMD ["node", "dist/app.js"]
